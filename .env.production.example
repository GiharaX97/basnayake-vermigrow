# Basnayaka Vermigrow — PRODUCTION environment (server-side)
# Copy to /etc/basnayakavermigrow.env on the VPS (chmod 600).
# This template has NO real secrets — generate them on the server.

NODE_ENV="production"
PORT="3001"
HOSTNAME="127.0.0.1"

# Absolute path to the SQLite DB, OUTSIDE the app dir so it survives redeploys.
DATABASE_URL="file:/var/www/basnayakavermigrow/db/custom.db"

# Public URL. Canonical host is www (apex redirects to it via Caddy).
# MUST match the build-time value (sitemap/canonical bake it in) and the value
# actually in /etc/basnayakavermigrow.env on the server (runtime, Secure cookie).
NEXTAUTH_URL="https://www.basnayakavermigrow.lk"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# Optional: only used to SEED the first login if the DB has no password hash yet.
# Once a hash exists in the DB, the DB password is authoritative (env does NOT override).
# ADMIN_PASSWORD=""

# --- SMS (optional) ---
# Unset = nothing is transmitted. Messages queue in Admin → Donations → Messages
# and are sent by hand. Setting SMS_PROVIDER turns on automatic sending: the
# moment a sale is recorded, or a paid order settled, the customer is texted with
# the amount their purchase gave to the community fund.
#
#   "text-lk"    TEXTLK_API_TOKEN + TEXTLK_SENDER_ID      (~LKR 0.64/SMS)
#   "notify-lk"  NOTIFY_USER_ID + NOTIFY_API_KEY + NOTIFY_SENDER_ID
#   "webhook"    SMS_GATEWAY_URL (+ optional SMS_GATEWAY_KEY) for your own bridge
#   "httpsms"    HTTPSMS_API_KEY + HTTPSMS_FROM — an Android phone running the
#                httpSMS app is the gateway; the only cost is that SIM's credit
#   "mock"       writes to .sms-outbox.log — testing only, never on the live site
SMS_PROVIDER=""
SMS_SENDER_ID=""
TEXTLK_API_TOKEN=""
TEXTLK_SENDER_ID=""
NOTIFY_USER_ID=""
NOTIFY_API_KEY=""
NOTIFY_SENDER_ID=""
SMS_GATEWAY_URL=""
SMS_GATEWAY_KEY=""

# httpSMS only — https://httpsms.com/settings for the key.
# HTTPSMS_FROM is the Android phone's own number, in +94771234567 form. It is
# what customers see and can reply to. KEEP THAT PHONE CHARGED, ONLINE AND
# RUNNING THE APP: the API only hands the message to it, so an offline handset
# silently accumulates unsent texts while this server believes they went out.
HTTPSMS_API_KEY=""
HTTPSMS_FROM=""
SMS_COUNTRY_CODE="94"

# Ceiling on automatic sends per day. The donation wall is PUBLIC, so this is
# what bounds the worst case a stranger can cause. Past the cap, messages stay
# queued for a human — they are not lost.
SMS_DAILY_CAP="200"

# Set to "off" to stop automatic sending without a redeploy.
SMS_AUTOSEND=""

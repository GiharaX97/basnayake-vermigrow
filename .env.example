# Basnayaka VermiGrow — Environment Variables
# Copy this file to .env (local dev) and adjust values.
# NEVER commit the real .env — it contains credentials.

# --- Local development ---
# SQLite path is relative to the prisma/ schema directory
DATABASE_URL="file:../db/custom.db"

# --- Production server ---
# On the Linux server, point at an absolute path OUTSIDE the app dir so it
# survives re-deploys, and is easy to back up. Example:
# DATABASE_URL="file:/var/www/basnayakavermigrow/db/custom.db"

# Admin password — used on first deploy to seed the hashed password.
# Set a strong random one, e.g. `openssl rand -base64 24`.
# After the first deploy the hash is stored in the DB; change it in Admin → Settings.
ADMIN_PASSWORD="change-this-to-a-strong-password"

# Random secret for any session signing. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"

# Base URL. IMPORTANT: for the site this is baked into the build
# (sitemap.xml uses it), so set the real public URL BEFORE running `next build`.
# Local dev:  NEXTAUTH_URL="http://localhost:3001"
# Production: NEXTAUTH_URL="https://basnayakavermigrow.lk"

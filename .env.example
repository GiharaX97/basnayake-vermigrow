# Basnayaka Vermigrow — Environment Variables
# Copy this file to .env (local dev) and adjust values.
# NEVER commit the real .env — it contains credentials.

# --- Local development ---
# SQLite path is relative to the prisma/ schema directory
DATABASE_URL="file:../db/custom.db"

# --- Production server ---
# On the Linux server, point at an absolute path OUTSIDE the app dir so it
# survives re-deploys, and is easy to back up. Example:
# DATABASE_URL="file:/var/www/basnayakavermigrow/db/custom.db"

# Admin password — used on first deploy to seed the hashed password.
# Set a strong random one, e.g. `openssl rand -base64 24`.
# After the first deploy the hash is stored in the DB; change it in Admin → Settings.
ADMIN_PASSWORD="change-this-to-a-strong-password"

# Random secret for any session signing. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"

# Base URL. IMPORTANT: for the site this is baked into the build
# (sitemap.xml uses it), so set the real public URL BEFORE running `next build`.
# Local dev:  NEXTAUTH_URL="http://localhost:3001"
# Production: NEXTAUTH_URL="https://basnayakavermigrow.lk"

# --- SMS (optional) ---
# WHICH GATEWAY TEXTS CUSTOMERS. Leave this unset and nothing is ever
# transmitted: messages queue up in Admin → Donations → Messages and are sent by
# hand from your phone. Setting it turns on automatic sending.
#
#   SMS_PROVIDER="mock"        writes each message to .sms-outbox.log, sends
#                              nothing, costs nothing — for testing the flow
#   SMS_PROVIDER="text-lk"     needs TEXTLK_API_TOKEN, TEXTLK_SENDER_ID   (~LKR 0.64/SMS)
#   SMS_PROVIDER="notify-lk"   needs NOTIFY_USER_ID, NOTIFY_API_KEY, NOTIFY_SENDER_ID
#   SMS_PROVIDER="webhook"     needs SMS_GATEWAY_URL — you POST {to, message, sender}
#                              to your own bridge (e.g. a Kannel relay)
#   SMS_PROVIDER="httpsms"     needs HTTPSMS_API_KEY, HTTPSMS_FROM — an Android
#                              phone running the httpSMS app is the gateway, so
#                              the only cost is that SIM's own credit. See below.
# SMS_PROVIDER=""

# Sender ID (the name the customer sees). Shared by the providers that need one.
SMS_SENDER_ID=""

# Credentials for the provider you chose. Only fill in the block you use.
TEXTLK_API_TOKEN=""
TEXTLK_SENDER_ID=""
NOTIFY_USER_ID=""
NOTIFY_API_KEY=""
NOTIFY_SENDER_ID=""
SMS_GATEWAY_URL=""
SMS_GATEWAY_KEY=""

# httpSMS only — https://httpsms.com
# The API key from https://httpsms.com/settings.
HTTPSMS_API_KEY=""
# The number of the Android phone running the app, e.g. "+94771234567".
# This is the number customers SEE and can reply to, so it should be the farm's
# own SIM. The phone must stay on and online: this API only queues the message
# onto it, and a phone that is flat or offline silently holds them back.
HTTPSMS_FROM=""

# Country code for numbers stored in local form (0771234567 -> 94771234567).
SMS_COUNTRY_CODE="94"

# Hard ceiling on AUTOMATIC sends per day, across the whole system. This is what
# bounds what the software can spend without anyone watching — the donation wall
# is public, so without it a stranger could run up the bill. Messages past the
# cap stay queued for a human. A send you trigger by hand is never capped.
SMS_DAILY_CAP="200"

# Kill switch. Set to "off" to stop automatic sending without a redeploy;
# messages keep queueing and can still be sent by hand.
SMS_AUTOSEND=""

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env*.example

# local-only secrets, DB backups, and agent tooling noise
SECRETS*.local.md
db/*.bak
.mimocode/

# DB snapshots taken before a migration or a test run, and the throwaway copy
# the end-to-end tests mutate. `db/*.db-*` above does NOT cover these — that
# pattern only matches SQLite's own sidecars (custom.db-journal).
db/*.backup-*
db/verify.db

# No SQLite file is ever source. This covers deck-demo.db and any future copy;
# the live DB holds customer phone numbers and orders. See the block at the end.
db/*.db

# Scratch files dumped while probing a gateway or a browser session. `.cookies.tmp`
# has held a live admin session cookie before, so none of this belongs in history.
*.tmp
*.tmp.json

# Scratch dirs and dumped agent transcripts. Both have turned up untracked in
# the repo root before; nothing here is source.
.tmp-*/
20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# live SQLite DB (client content + hashes) — never push
db/custom.db
db/*.db-*
# throwaway copy the e2e suite runs against (scripts/run-e2e.sh)
db/e2e.db
# ...and the one the SMS suite runs against (scripts/run-e2e-sms.sh). Both are
# copies of the live DB, so neither may ever be committed.
db/sms-e2e.db
